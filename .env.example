# Required in production. Use long, unique values. Never commit real values.
STREAMALL_ACCESS_PASSWORD=
STREAMALL_SESSION_SECRET=

# Google Sheets source of truth. Share the sheet with the service-account email.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Provider credentials. Audius bearer token and YouTube key stay server-side.
AUDIUS_API_KEY=
AUDIUS_BEARER_TOKEN=
YOUTUBE_API_KEY=
JAMENDO_CLIENT_ID=

# Development/test controls.
STREAMALL_REPOSITORY=memory
ENABLE_PLATFORM_LAB=false
